[Unit]
Description=Protune encrypted database backup
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=protune
WorkingDirectory=/opt/protune
EnvironmentFile=/etc/protune/backup.env
ExecStart=/usr/bin/node --import tsx scripts/scheduled-backup.ts
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
