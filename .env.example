DATABASE_URL="postgresql://protune:CHANGE_ME@localhost:5432/protune"
APP_ORIGIN="http://127.0.0.1:3000"
SEED_OWNER_EMAIL="owner@protune.local"
# Set a unique password of at least 12 characters before seeding.
SEED_OWNER_PASSWORD=""

# Phase 5: delivery remains disabled until server and owner settings both allow it.
MARKETING_LIVE_ENABLED="false"
PUBLIC_APP_ORIGIN=""
EMAIL_PROVIDER="SMTP"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional OAuth access token instead of a password (renew outside the application).
SMTP_ACCESS_TOKEN=""
# Optional Resend alternative.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# Set a supported Graph API version in provider configuration.
WHATSAPP_API_VERSION=""

# Phase 6: enable only behind the supplied trusted reverse proxy.
TRUST_PROXY="false"
# Generate 32 random bytes and store the base64 key separately from backups.
BACKUP_KEY=""
BACKUP_DIR=""
BACKUP_RETENTION_DAYS="30"
RESTORE_DATABASE_URL=""
RESTORE_CONFIRM=""
